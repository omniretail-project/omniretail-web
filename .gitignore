# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local UX references
/reference/ModuloBodega/

# accidental root-level diagnostics
/base.txt
/branch.txt
/head.txt
/diff_name_status.txt
/diff_output.txt
/diff_stat.txt
/status.txt
/hort
/tatus

# next.js
/.next/
# Builds con distDir alternativo: Tailwind v4 escanea lo que no esté ignorado y rompe con su caché binaria.
/.next-demo/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
