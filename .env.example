# Modo de datos: mock (default, repositorios simulados) | api (login/sesion contra el backend real).
NEXT_PUBLIC_API_MODE=mock

# URL del backend. SOLO servidor (Route Handlers de app/api/auth): nunca usar prefijo NEXT_PUBLIC.
OMNIRETAIL_API_URL=http://localhost:8080/api/v1

# Client ID web de Google Cloud para "Continuar con Google" (solo login de la tienda, modo api). Es el
# mismo GOOGLE_CLIENT_ID del backend, con http://localhost:3000 como origen autorizado. Vacio o en
# modo mock, el boton muestra el aviso "no disponible".
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Demo pública (MARJYM) ---
# Solo en el build de la DEMO: "true" activa el modo demo público.
# Únicamente tiene efecto si NEXT_PUBLIC_API_MODE=mock. En el build real, déjala vacía.
NEXT_PUBLIC_PUBLIC_DEMO=

# Solo en el build de la DEMO: URL absoluta de la landing real (sin "/" al final).
# La usan "Contratar MARJYM" y "Volver al inicio". Ej: https://marjym.com
NEXT_PUBLIC_MARKETING_URL=

# Solo en el build REAL: URL absoluta de la instancia demo (sin "/" al final).
# Si está vacía, la landing no muestra el botón "Probar demo". Ej: https://demo.marjym.com
NEXT_PUBLIC_DEMO_URL=

# Opcional, en el build de la DEMO: enlace de contacto comercial (WhatsApp o mailto).
# Si está vacía, la franja no muestra "¿Quieres que te contactemos?". Ej: https://wa.me/502XXXXXXXX
NEXT_PUBLIC_SALES_CONTACT_URL=

# --- SEO del sitio comercial oficial ---
# SOLO en el build de marjym.com: "https://marjym.com" (sin "/" al final). Activa canonical, Open Graph,
# datos estructurados, sitemap.xml y las cabeceras noindex de las rutas que no se posicionan.
# En instalaciones de clientes y en la demo, déjala VACÍA: no se aplica ninguna configuración SEO de MARJYM.
NEXT_PUBLIC_SITE_URL=